  {
    "_key": "cf6de7c7afb1",
    "_type": "faqBlock",
    "faq": {
      "_type": "accordionBlock",
      "items": [
        {
          "_key": "e9ef92447798",
          "answer": [
            {
              "_key": "cb9491214a67",
              "_type": "block",
              "children": [
                {
                  "_key": "8668bf4e5f11",
                  "_type": "span",
                  "marks": [],
                  "text": "A standard beauty salon website takes 2–3 weeks, including design, booking integration and SEO setup. More complex projects (multi-language, CRM integration) may take up to 4 weeks."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "How long does it take to build a salon website?"
        },
        {
          "_key": "ed0e988a46e5",
          "answer": [
            {
              "_key": "4aa17c445fe4",
              "_type": "block",
              "children": [
                {
                  "_key": "9c2ec0eaee9d",
                  "_type": "span",
                  "marks": [],
                  "text": "Projects start at €700 / $750, depending on features and content scope. After a short briefing, I provide a detailed quote with timeline and milestones."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "What’s the cost of beauty salon website design?"
        },
        {
          "_key": "f1921df7d438",
          "answer": [
            {
              "_key": "727158cad64f",
              "_type": "block",
              "children": [
                {
                  "_key": "32d816d63aa4",
                  "_type": "span",
                  "marks": [],
                  "text": "Yes. Social media shows your work, but it doesn’t rank on Google. A website gives you search visibility, credibility, and automated bookings — plus full control over your brand."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Do I need a website if I already have Instagram or Facebook?"
        },
        {
          "_key": "38d5570d730b",
          "answer": [
            {
              "_key": "f78e9e9d404e",
              "_type": "block",
              "children": [
                {
                  "_key": "fef8189b5a2c",
                  "_type": "span",
                  "marks": [],
                  "text": "Absolutely. I integrate Stripe, PayPal or local payment systems with online scheduling so clients can reserve and prepay securely."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Can clients book and pay online?"
        },
        {
          "_key": "4593651ebb2e",
          "answer": [
            {
              "_key": "e0920e392960",
              "_type": "block",
              "children": [
                {
                  "_key": "f9db1f3cc4af",
                  "_type": "span",
                  "marks": [],
                  "text": "Yes. You’ll get a clean admin panel and step-by-step training to edit text, photos and offers independently."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Will I be able to update my website myself?"
        },
        {
          "_key": "89495fe824ff",
          "answer": [
            {
              "_key": "39f547ab8f2f",
              "_type": "block",
              "children": [
                {
                  "_key": "2e1a39c623fe",
                  "_type": "span",
                  "marks": [],
                  "text": "Yes. Each site is built for both — local SEO to reach clients near you, and global SEO to attract international audiences."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Is the website optimized for local and international SEO?"
        }
      ]
    }
  },
