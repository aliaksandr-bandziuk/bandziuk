  {
    "_key": "cf6de7c7afb1",
    "_type": "faqBlock",
    "faq": {
      "_type": "accordionBlock",
      "items": [
        {
          "_key": "e9ef92447798",
          "answer": [
            {
              "_key": "cb9491214a67",
              "_type": "block",
              "children": [
                {
                  "_key": "8668bf4e5f11",
                  "_type": "span",
                  "marks": [],
                  "text": "Standardowa realizacja trwa 2–3 tygodnie — od projektu po wdrożenie. W przypadku wersji wielojęzycznej lub integracji systemu rezerwacji czas może wydłużyć się do 4 tygodni."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Ile trwa stworzenie strony salonu kosmetycznego?"
        },
        {
          "_key": "ed0e988a46e5",
          "answer": [
            {
              "_key": "4aa17c445fe4",
              "_type": "block",
              "children": [
                {
                  "_key": "9c2ec0eaee9d",
                  "_type": "span",
                  "marks": [],
                  "text": "Ceny zaczynają się od 1600–1800 zł netto i zależą od zakresu funkcji (rezerwacje, blog, SEO). Po rozmowie otrzymasz szczegółową wycenę."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Ile kosztuje strona dla salonu urody?"
        },
        {
          "_key": "f1921df7d438",
          "answer": [
            {
              "_key": "727158cad64f",
              "_type": "block",
              "children": [
                {
                  "_key": "32d816d63aa4",
                  "_type": "span",
                  "marks": [],
                  "text": "Tak. Instagram przyciąga uwagę, ale to strona internetowa buduje zaufanie i umożliwia rezerwację oraz widoczność w Google."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Czy potrzebuję strony, jeśli mam profil na Instagramie?"
        },
        {
          "_key": "38d5570d730b",
          "answer": [
            {
              "_key": "f78e9e9d404e",
              "_type": "block",
              "children": [
                {
                  "_key": "fef8189b5a2c",
                  "_type": "span",
                  "marks": [],
                  "text": "Oczywiście. Otrzymasz prosty panel CMS i krótką instrukcję wideo, jak edytować treści."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Czy mogę samodzielnie aktualizować treści?"
        },
        {
          "_key": "4593651ebb2e",
          "answer": [
            {
              "_key": "e0920e392960",
              "_type": "block",
              "children": [
                {
                  "_key": "f9db1f3cc4af",
                  "_type": "span",
                  "marks": [],
                  "text": "Tak, każda strona jest w pełni responsywna — ładuje się szybko i wygląda świetnie na każdym urządzeniu."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Czy strona będzie działać dobrze na telefonach?"
        },
        {
          "_key": "89495fe824ff",
          "answer": [
            {
              "_key": "39f547ab8f2f",
              "_type": "block",
              "children": [
                {
                  "_key": "2e1a39c623fe",
                  "_type": "span",
                  "marks": [],
                  "text": "Tak. Optymalizuję strukturę, treści i metadane, aby Twoja strona była widoczna w wynikach wyszukiwania i na mapach Google."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Czy strona będzie zoptymalizowana pod SEO?"
