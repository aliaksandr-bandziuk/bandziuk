              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "How long does business website development take?"
        },
        {
          "_key": "db0545041e01",
          "answer": [
            {
              "_key": "8eff294b4a5d",
              "_type": "block",
              "children": [
                {
                  "_key": "3f55b42a86cd",
                  "_type": "span",
                  "marks": [],
                  "text": "Both options are possible, but many projects benefit from a clean, strategic rebuild."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Do you redesign existing websites or only build new ones?"
        },
        {
          "_key": "a6a1a7128545",
          "answer": [
            {
              "_key": "66c74e2dbd9c",
              "_type": "block",
              "children": [
                {
                  "_key": "313af889e3fd",
                  "_type": "span",
                  "marks": [],
                  "text": "Yes. The site is built with SEO fundamentals integrated from the start."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Is the website ready for SEO after launch?"
        },
        {
          "_key": "ef2301ae1e2e",
          "answer": [
            {
              "_key": "68557dfdbad9",
              "_type": "block",
              "children": [
                {
                  "_key": "e2106faa946d",
                  "_type": "span",
                  "marks": [],
                  "text": "Absolutely. Scalability is part of the core architecture."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Can the website be expanded later?"
        },
        {
          "_key": "4b3a817ec727",
