                  "_key": "0d36cdcb4f6f",
                  "_type": "span",
                  "marks": [],
                  "text": "Pricing reflects the depth of architecture and functionality — not just visual design."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "How much does garage website design and development cost?"
        },
        {
          "_key": "db0545041e01",
          "answer": [
            {
              "_key": "63af8dbefa3c",
              "_type": "block",
              "children": [
                {
                  "_key": "e42de82bc29d",
                  "_type": "span",
                  "marks": [],
                  "text": "Typical development timelines range from 3 to 6 weeks. This includes planning, service structuring, interface design, technical build and performance optimisation."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
            {
