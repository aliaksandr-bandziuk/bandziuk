  {
    "_key": "2c7dcffcd789",
    "_type": "gridBlock",
    "items": [
      {
        "_key": "7d3574015939",
        "description": "You receive a fully developed website built around your workshop’s real services and operational structure. The architecture reflects how your business works — not a generic template adapted at the last minute.",
        "iconName": "trending-up",
        "title": "A Structured, Professionally Developed Garage Website"
      },
      {
        "_key": "e654be6ce7f9",
        "description": "Each key service (MOT, servicing, diagnostics, tyres, brakes, suspension, electrical repairs, etc.) is presented on its own structured page. This improves clarity for customers and creates a scalable framework for future expansion.",
        "iconName": "layers",
        "title": "Dedicated Service Pages for Every Core Offering"
      },
      {
        "_key": "136ca6018909",
        "description": "The booking flow is designed around how your workshop actually schedules jobs. Whether you prefer structured appointment requests or enquiry-based contact, the system supports efficient handling of customer communication.",
        "iconName": "zap",
        "title": "A Booking or Enquiry System Aligned with Your Workflow"
      },
      {
        "_key": "f8b3c37ab413",
        "description": "The website is built with mobile-first principles. Fast loading times, clear call-to-action placement and intuitive navigation ensure customers can book or contact you quickly — especially from smartphones.",
        "iconName": "sparkles",
        "title": "Mobile-Optimised, Fast-Loading Performance"
      },
      {
        "_key": "c43dd10df408",
        "description": "Behind the interface is a structured and scalable technical build. The website is easy to maintain, extend and upgrade without requiring a full rebuild in the future.",
        "iconName": "target",
        "title": "Clean, Maintainable Technical Foundation"
      },
      {
        "_key": "6aa2869ca992",
        "description": "You retain ownership of your website. The architecture allows for adding new services, expanding into new areas, integrating additional functionality or developing new content sections as your business grows.",
        "iconName": "rocket",
        "title": "Full Ownership and Long-Term Scalability"
      }
    ],
    "marginBottom": "medium",
    "marginTop": "medium",
    "title": "What You Receive After Development"
  },
