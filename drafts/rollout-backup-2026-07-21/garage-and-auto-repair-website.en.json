    "faq": {
      "_type": "accordionBlock",
      "items": [
        {
          "_key": "07ed69ca8ade",
          "answer": [
            {
              "_key": "b507b8d172b2",
              "_type": "block",
              "children": [
                {
                  "_key": "27f5e7456104",
                  "_type": "span",
                  "marks": [],
                  "text": "The cost depends on the number of services, complexity of booking systems, integrations and structural requirements. A small workshop website differs significantly from a multi-service platform with structured appointment handling."
                }
              ],
              "markDefs": [],
              "style": "normal"
            },
