          "_key": "07ed69ca8ade",
          "answer": [
            {
              "_key": "d575d3a4297e",
              "_type": "block",
              "children": [
                {
                  "_key": "97a62e60b28d",
                  "_type": "span",
                  "marks": [],
                  "text": "You can usually notice the first positive changes within 2–3 months, while consistent and steady growth tends to develop over the following 4–6 months."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "How long does SEO for an auto repair shop take?"
        },
        {
          "_key": "db0545041e01",
          "answer": [
            {
              "_key": "8eff294b4a5d",
              "_type": "block",
              "children": [
                {
                  "_key": "3f55b42a86cd",
                  "_type": "span",
                  "marks": [],
                  "text": "Yes. Local SEO delivers particularly strong results for small and medium-sized automotive service businesses."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Is SEO effective for small auto repair shops?"
        },
        {
          "_key": "a6a1a7128545",
          "answer": [
            {
              "_key": "50b8c5a111ba",
              "_type": "block",
              "children": [
                {
                  "_key": "3afb70f9a9c9",
                  "_type": "span",
                  "marks": [],
                  "text": "Yes. AI-powered search systems increasingly recommend businesses based on trusted content sources."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Can customers come from ChatGPT or AI search tools?"
        },
        {
          "_key": "ef2301ae1e2e",
          "answer": [
            {
              "_key": "68557dfdbad9",
              "_type": "block",
              "children": [
                {
                  "_key": "e2106faa946d",
                  "_type": "span",
                  "marks": [],
                  "text": "Traditional SEO is aimed at improving search rankings, whereas GEO and AEO are designed to increase visibility within AI-generated responses."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "What is the difference between SEO and AI search optimization?"
        },
        {
          "_key": "4b3a817ec727",
          "answer": [
            {
              "_key": "1d96d5ca4b0f",
              "_type": "block",
              "children": [
                {
                  "_key": "60536ca60299",
                  "_type": "span",
                  "marks": [],
                  "text": "No. SEO can work as a standalone lead generation channel."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Do I need paid ads together with SEO?"
        },
        {
          "_key": "22260917457c",
          "answer": [
            {
              "_key": "ae531b4807da",
              "_type": "block",
              "children": [
                {
                  "_key": "9a9280026240",
                  "_type": "span",
                  "marks": [],
                  "text": "Да, SEO — самостоятельный канал привлечения клиентов."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "question": "Работает ли SEO без рекламы?"
        }
