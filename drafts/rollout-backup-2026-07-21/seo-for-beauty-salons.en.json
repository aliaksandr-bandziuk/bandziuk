  {
    "_key": "2c7dcffcd789",
    "_type": "gridBlock",
    "items": [
      {
        "_key": "7d3574015939",
        "description": "You receive a clear, prioritized plan based on your services, location and competition — not a generic checklist. Every action is aligned with booking growth and long-term visibility.",
        "iconName": "trending-up",
        "title": "Strategic SEO Roadmap Tailored to Your Salon"
      },
      {
        "_key": "e654be6ce7f9",
        "description": "Your most profitable treatments (hair, nails, aesthetic services, etc.) gain stronger positions in search results, attracting clients actively looking for those services.",
        "iconName": "layers",
        "title": "Increased Visibility for Core Services"
      },
      {
        "_key": "136ca6018909",
        "description": "Your salon becomes more visible in local search results and map listings, helping you capture high-intent queries like “beauty salon near me” or “[service] in [city].”",
        "iconName": "zap",
        "title": "Stronger Local Search Presence"
      },
      {
        "_key": "f8b3c37ab413",
        "description": "Each key service is structured and optimized to rank and guide visitors toward booking — with clear messaging, trust signals and simplified appointment flow.",
        "iconName": "sparkles",
        "title": "Optimized Service Pages Built to Convert"
      },
      {
        "_key": "c43dd10df408",
        "description": "As organic visibility grows, your dependency on paid ads decreases, creating a more stable and predictable client acquisition model.",
        "iconName": "target",
        "title": "Reduced Reliance on Paid Advertising"
      },
      {
        "_key": "6aa2869ca992",
        "description": "SEO becomes a long-term growth asset that continues generating demand as your salon expands services, team size or new locations.",
        "iconName": "rocket",
        "title": "A Scalable Client Acquisition Channel"
      }
    ],
    "marginBottom": "medium",
    "marginTop": "medium",
    "title": "What You Get as a Result"
  },
