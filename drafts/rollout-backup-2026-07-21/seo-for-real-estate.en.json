            "_type": "block",
            "children": [
              {
                "_key": "f05b2b72bb95",
                "_type": "span",
                "marks": [],
                "text": "On the content side, SEO aligns your website with real search behavior. Buyers search differently at each stage — from early research to ready-to-buy queries. SEO content addresses these stages by improving visibility for both informational and commercial searches."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
