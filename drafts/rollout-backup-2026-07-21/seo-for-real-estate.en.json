              {
                "_key": "478c81c3bb5c",
                "_type": "span",
                "marks": [],
                "text": "Real estate SEO requires a balance between technical optimization and content clarity. Search engines must clearly understand your pages, while users must immediately see value."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "c4e941557e45",
