            "children": [
              {
                "_key": "9b4d917c2b7d",
                "_type": "span",
                "marks": [],
                "text": "On the technical side, SEO focuses on site structure, page speed, internal linking, and indexation. These elements ensure that property listings, category pages, and location pages are properly discovered and ranked by Google."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
